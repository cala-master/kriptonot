{
  "name": "kriptonot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "validate": "node scripts/validation/run-validation.mjs",
    "test": "node --test tests/contract/*.test.mjs tests/integration/*.test.mjs",
    "test:contracts": "node --test tests/contract/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "manual:bootstrap": "node scripts/manual/print-bootstrap-runbook.mjs",
    "app:dev": "pnpm --filter @kriptonot/desktop dev",
    "app:build": "pnpm --filter @kriptonot/desktop build",
    "app:typecheck": "pnpm --filter @kriptonot/desktop typecheck",
    "app:tauri:dev": "pnpm --filter @kriptonot/desktop tauri dev",
    "app:tauri:build": "pnpm --filter @kriptonot/desktop tauri build"
  }
}
